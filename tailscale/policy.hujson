// Tailscale access policy for the homelab tailnet, kept in git.
// Apply: Tailscale admin console, Access controls, paste this file (week 3: automate with
// the tailscale/gitops-acl-action so a merged PR updates the policy).
//
// Model: nobody reaches the lab LAN unless a rule below says so. The gateway is a tagged
// device (owned by the tailnet, not a person), so its node key never expires and it is
// not tied to anyone's login.
{
  "tagOwners": {
    // Only tailnet admins may enroll a device with this tag.
    "tag:homelab-gateway": ["autogroup:admin"],
    // Break-glass node on the hypervisor (ADR 0003). Routes nothing.
    "tag:homelab-breakglass": ["autogroup:admin"],
  },

  // Routes advertised by tagged gateways are approved automatically (no manual click per route).
  // Only this exact subnet, only from this tag.
  "autoApprovers": {
    "routes": {
      "192.168.1.0/24": ["tag:homelab-gateway"],
    },
  },

  "grants": [
    // Tailnet members (you) may reach the whole lab LAN through the gateway.
    {
      "src": ["autogroup:member"],
      "dst": ["192.168.1.0/24"],
      "ip":  ["*"],
    },
    // Members may reach the gateway itself (for diagnostics).
    {
      "src": ["autogroup:member"],
      "dst": ["tag:homelab-gateway"],
      "ip":  ["*"],
    },
    // Break-glass: members may reach the hypervisor directly when the gateway is down.
    // TODO(you): write this grant. Allow only the ports you need to repair the lab, nothing more.
    //   src: who may use the back door?   dst: "tag:homelab-breakglass"
    //   ip:  which ports? ("tcp:NN" strings). Not "*": the hypervisor is the crown jewel.

    // Deliberately NO rule allowing tag:homelab-gateway to initiate connections to members:
    // a compromised gateway cannot reach your laptop over the tailnet.
  ],

  // Test `src` must be a specific user, group, tag or host: autogroups are not allowed here, and
  // naming a user would put a login email in this public repo. So tests are written from the
  // gateway's side; member access is proven by the hotspot test in the runbook instead.
  "tests": [
    {
      // The gateway gets no tailnet grant of its own: it routes for members, it cannot use the LAN.
      "src":  "tag:homelab-gateway",
      "deny": ["192.168.1.181:8006", "192.168.1.90:22"],
    },
    {
      // A compromised gateway cannot connect back to the Mac (its Tailscale IP, from Machines).
      "src":  "tag:homelab-gateway",
      "deny": ["100.117.210.50:22", "100.117.210.50:5900"],
    },
    // TODO(you): a test that the gateway cannot reach the break-glass node, so one compromised
    // entry point cannot be used to reach the other. (Tag names are valid test destinations.)
  ],
}
