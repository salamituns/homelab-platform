# Managed by Ansible (homelab-platform, playbook: k8s-etcd-backup.yml).
# 00:45 host time (America/Chicago): before the 01:30 PBS daily-all job.
[Unit]
Description=Daily etcd snapshot timer

[Timer]
OnCalendar={{ etcd_backup_oncalendar }}
Persistent=true
Unit=k8s-etcd-backup.service

[Install]
WantedBy=timers.target
