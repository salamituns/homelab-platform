# Managed by Ansible (homelab-platform, role: jenkins). Local edits are overwritten.
# Only credentials whose secret files exist are listed. JCasC fails on a missing readFile.
credentials:
  system:
    domainCredentials:
      - credentials:
{% if jenkins_has_nexus_ci_push | bool %}
          - usernamePassword:
              scope: GLOBAL
              id: nexus-ci-push
              description: Nexus ci-push (belleshop repo only)
              username: "{{ jenkins_nexus_ci_push_user }}"
              password: "${readFile:/etc/jenkins/secrets/nexus-ci-push}"
{% endif %}
{% if jenkins_has_nexus_ci_pull | bool %}
          - usernamePassword:
              scope: GLOBAL
              id: nexus-ci-pull
              description: Nexus ci-pull (read-only on ghcr proxy for Trivy DBs)
              username: "{{ jenkins_nexus_ci_pull_user }}"
              password: "${readFile:/etc/jenkins/secrets/nexus-ci-pull}"
{% endif %}
{% if jenkins_has_sonarqube_token | bool %}
          - string:
              scope: GLOBAL
              id: sonarqube-token
              description: SonarQube token for withSonarQubeEnv('sonarqube')
              secret: "${readFile:/etc/jenkins/secrets/sonarqube-token}"
{% endif %}
{% if jenkins_has_cosign_key | bool %}
          - file:
              scope: GLOBAL
              id: cosign-key
              description: Cosign encrypted private key
              fileName: cosign.key
              secretBytes: "${readFileBase64:/etc/jenkins/secrets/cosign-key}"
{% endif %}
{% if jenkins_has_cosign_password | bool %}
          - string:
              scope: GLOBAL
              id: cosign-password
              description: Password for the Cosign private key
              secret: "${readFile:/etc/jenkins/secrets/cosign-password}"
{% endif %}
{% if jenkins_has_gitea_token | bool %}
          - giteaAccessToken:
              scope: GLOBAL
              id: gitea-jenkins
              description: Gitea PAT for SCM and webhook management
              token: "${readFile:/etc/jenkins/secrets/gitea-jenkins}"
{% endif %}
{% if jenkins_has_gitea_promote_token | bool %}
          - usernamePassword:
              scope: GLOBAL
              id: gitea-ci-promote
              description: Gitea ci-promote bot, opens PRs in belleshop-deploy only (ADR 0012)
              username: "{{ jenkins_gitea_promote_user }}"
              password: "${readFile:/etc/jenkins/secrets/gitea-ci-promote}"
{% endif %}
{% if jenkins_has_nexus_push_personal_site | bool %}
          - usernamePassword:
              scope: GLOBAL
              id: nexus-push-personal-site
              description: Nexus push-personal-site (personal-site repo only, ADR 0019)
              username: "{{ jenkins_nexus_push_personal_site_user }}"
              password: "${readFile:/etc/jenkins/secrets/nexus-push-personal-site}"
{% endif %}
{% if jenkins_has_personal_site_source_repo | bool %}
          - string:
              scope: GLOBAL
              id: personal-site-source-repo
              description: GitHub owner/repo of the personal site (contains the public domain; from gitignored private/)
              secret: "${readFile:/etc/jenkins/secrets/personal-site-source-repo}"
{% endif %}
{% if jenkins_has_promoter_watchdog_url | bool %}
          - string:
              scope: GLOBAL
              id: promoter-watchdog-url
              description: healthchecks ping URL for personal-site-promoter (from gitignored private/)
              secret: "${readFile:/etc/jenkins/secrets/promoter-watchdog-url}"
{% endif %}
