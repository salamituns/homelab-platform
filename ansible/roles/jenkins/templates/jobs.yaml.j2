# Managed by Ansible (homelab-platform, role: jenkins). Local edits are overwritten.
# Job DSL (plugin job-dsl). Owner comes from extra vars, never from git.
jobs:
  - script: |
      multibranchPipelineJob('belleshop') {
        displayName('BelleShop')
        description('Gitea multibranch. Jenkinsfile at repo root. Gates are /opt/ci-gates on the docker agent.')
        branchSources {
          gitea {
            id('belleshop')
            serverUrl('{{ jenkins_gitea_url }}')
            repoOwner('{{ jenkins_belleshop_owner }}')
            repository('{{ jenkins_belleshop_repo }}')
            credentialsId('gitea-jenkins')
            traits {
              giteaBranchDiscovery {
                strategyId(3)
              }
              giteaPullRequestDiscovery {
                strategyId(2)
              }
            }
          }
        }
        factory {
          workflowBranchProjectFactory {
            scriptPath('{{ jenkins_belleshop_script_path }}')
          }
        }
        orphanedItemStrategy {
          discardOldItems {
            numToKeep(20)
          }
        }
      }
