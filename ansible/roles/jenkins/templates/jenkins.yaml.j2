# Managed by Ansible (homelab-platform, role: jenkins). Local edits are overwritten.
#
# Credentials, SonarQube, Gitea, and jobs live in sibling YAML next to this file
# (credentials.yaml, sonar.yaml, gitea.yaml, jobs.yaml) so a missing secret can
# omit that fragment instead of breaking ${readFile:...}.
jenkins:
  numExecutors: 0
  mode: EXCLUSIVE
  slaveAgentPort: -1
  markupFormatter:
    plainText: {}
  crumbIssuer:
    standard: {}   # CSRF protection; excludeClientIPFromCrumb no longer exists in 2.580 (JCasC rejects unknown keys)
  securityRealm:
    local:
      allowsSignup: false
      users:
        - id: "{{ jenkins_admin_user }}"
          password: "${readFile:{{ jenkins_admin_password_file }}}"
  authorizationStrategy:
    globalMatrix:
      entries:
        - user:
            name: "{{ jenkins_admin_user }}"
            permissions:
              - Overall/Administer
        - group:
            name: authenticated
            permissions:
              - Overall/Read
  nodes:
    - permanent:
        name: "{{ jenkins_agent_name }}"
        labelString: "{{ jenkins_agent_label }}"
        remoteFS: "{{ jenkins_agent_remote_fs }}"
        numExecutors: {{ jenkins_agent_executors }}
        mode: NORMAL
        retentionStrategy: "always"
        launcher:
          inbound:
            webSocket: true

unclassified:
  location:
    url: "{{ jenkins_url }}"
    adminAddress: admin@home.arpa
