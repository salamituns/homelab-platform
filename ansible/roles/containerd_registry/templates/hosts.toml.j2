# Managed by the containerd_registry role. Per-host registry config for containerd's CRI plugin
# (docs/hosts.md in the containerd repo). Pulls from {{ item.host }} verify the server against the
# CA below: Caddy's local root CA, fetched to this repo by the nexus role (ADR 0011).
#
# The CA sits on the `server` entry itself, not in a separate [host."..."] table: containerd tries the host
# tables first and then falls back to `server`, so a `server` without the CA turned every failed pull
# (e.g. missing credentials) into a misleading "x509: certificate signed by unknown authority" (2026-10-29).
server = "https://{{ item.host }}"
ca = "{{ containerd_registry_certs_d }}/{{ item.host }}/ca.crt"
capabilities = ["pull", "resolve"]
