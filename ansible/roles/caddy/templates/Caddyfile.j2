# Managed by Ansible (homelab-platform, role: caddy). Local edits are overwritten.
{% for site in caddy_sites %}
{{ site.names | join(', ') }} {
	tls internal
{% if site.allowed_clients is defined %}
	# Only listed IPs may use this site (remote_ip matches packet source, so SNATed
	# clients appear as their gateway); everything else gets 403 at the TLS door.
	@blocked not remote_ip {{ site.allowed_clients | map(attribute='ip') | join(' ') }}
	respond @blocked 403
{% endif %}
{% if site.blocked_paths is defined %}
	# Path block list: these paths answer 403 before the proxy sees them, whatever the
	# client. Caddy path patterns: * is a fast-suffix match, so /v1/sys/generate-root*
	# covers /v1/sys/generate-root/attempt and -update alike. Used for the OpenBao
	# break-glass endpoints that must stay reachable ONLY on the host itself
	# (127.0.0.1:8200), never through bao.home.arpa (runbook openbao.md §6).
	@blockedpath path {{ site.blocked_paths | join(' ') }}
	respond @blockedpath 403
{% endif %}
{% if site.routes is defined %}
{% for route in site.routes %}
	handle {{ route.path }} {
		reverse_proxy {{ route.upstream }}
	}
{% endfor %}
	handle {
		reverse_proxy {{ site.upstream }}
	}
{% else %}
	reverse_proxy {{ site.upstream }}
{% endif %}
}
{% endfor %}
